# Copy to .env in the repo root. .env is gitignored.
# npm run deploy and npm run attach-domain load this file into the process environment.
# A value already set in the shell wins. Leave a line blank to skip it.
# Do not put these values in terraform.tfvars or backend.hcl.

# Account API token, Pages Edit. Not an R2 token.
CLOUDFLARE_API_TOKEN=

# 32 hex account id. Only needed when Wrangler can see more than one account.
CLOUDFLARE_ACCOUNT_ID=

# R2 S3 credentials for Terraform state. Not the Pages token.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REQUEST_CHECKSUM_CALCULATION=when_required

# S3 API endpoint from the R2 bucket page. Default shape:
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# A jurisdiction bucket uses a different host. Paste the host the dashboard shows.
# On terraform init, npm run attach-domain uses this value over endpoints.s3 in backend.hcl.
AWS_ENDPOINT_URL_S3=

# Private R2 bucket that stores Terraform state. Lowercase letters, digits, and hyphens.
# This replaces infra/cloudflare/backend.hcl. The bucket must already exist.
R2_STATE_BUCKET=
