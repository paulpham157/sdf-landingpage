{
  "name": "sdf-landingpage",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing site for Software Decision Fabric (softwaredecisionfabric.tech).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/copy-excalidraw-assets.mjs",
    "dev": "astro dev --host",
    "prebuild": "node scripts/copy-excalidraw-assets.mjs",
    "build": "astro build",
    "preview": "astro preview --host",
    "check:copy": "node scripts/check-constraints.mjs",
    "check:jsonld": "node scripts/check-jsonld.mjs",
    "check:draw": "node scripts/check-draw.mjs",
    "test:draw": "playwright test",
    "deploy": "node scripts/deploy.mjs",
    "test:deploy": "node --test scripts/deploy.test.mjs",
    "test:env-file": "node --test scripts/env-file.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "7.1.9",
    "@astrojs/sitemap": "^3.7.4",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "wrangler": "4.158.0"
  }
}
