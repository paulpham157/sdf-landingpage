---
import Mailto from "./Mailto.astro";
import { shipsToday, site } from "../data/site";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-name">Software Decision Fabric</p>
      <p class="footer-tag">{site.tagline}</p>
      <p class="footer-install"><code>{shipsToday.install}</code></p>
      <p>
        <a href={site.repo} rel="noopener noreferrer">GitHub repository</a>
      </p>
      <p>
        <a href={site.docsUrl} rel="noopener noreferrer">Docs</a>
      </p>
      <p>
        <a href={shipsToday.releaseUrl} rel="noopener noreferrer">v0.1.0 prebuilt archives</a>
      </p>
    </div>
    <nav aria-label="Footer">
      <ul>
        <li><a href="/">Overview</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/one-pager">One-pager</a></li>
        <li><a href="/sample-evidence-report">Sample Evidence Report</a></li>
        <li><a href="/design-partners">Design partners</a></li>
      </ul>
    </nav>
    <div>
      <p class="footer-label">Contact</p>
      <p>
        <Mailto class="footer-email" />
      </p>
    </div>
  </div>
  <div class="wrap footer-end">
    <p>© {new Date().getFullYear()} Software Decision Fabric</p>
    <p>{site.url.replace("https://", "")}</p>
  </div>
</footer>
