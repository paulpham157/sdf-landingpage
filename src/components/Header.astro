---
import Seal from "./Seal.astro";
import { hero, site } from "../data/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const links: { href: string; label: string; external?: boolean }[] = [
  { href: "/#how-it-works", label: "How it works" },
  { href: "/pricing", label: "Pricing" },
  { href: "/blog", label: "Blog" },
  { href: "/one-pager", label: "One-pager" },
  { href: "/sample-evidence-report", label: "Sample report" },
  { href: site.docsUrl, label: "Docs", external: true },
  { href: site.repo, label: "GitHub", external: true },
];

function isCurrent(href: string) {
  if (href.startsWith("/#")) return undefined;
  if (href === "/blog") {
    return pathname === "/blog" || pathname.startsWith("/blog/") ? "page" : undefined;
  }
  return pathname === href ? "page" : undefined;
}
---

<header class="site-header">
  <button type="button" class="nav-backdrop" hidden tabindex="-1" aria-label="Close menu"></button>
  <div class="wrap header-bar">
    <a class="brand" href="/" aria-current={pathname === "/" ? "page" : undefined}>
      <Seal />
      <span class="brand-text">
        <span class="brand-short" aria-hidden="true">SDF</span>
        <span class="brand-name">Software Decision Fabric</span>
        <span class="brand-tag">{site.headerTagline}</span>
      </span>
    </a>
    <nav class="primary-nav primary-nav-bar" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href)} rel={link.external ? "noopener noreferrer" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <details class="nav-disclosure">
      <summary class="nav-summary">Menu</summary>
      <nav class="primary-nav" aria-label="Menu">
        <a class="menu-cta" href="/#today">{hero.primaryCta}</a>
        {
          links.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href)} rel={link.external ? "noopener noreferrer" : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </details>
    <a class="button header-cta" href="/#today">{hero.primaryCta}</a>
  </div>
</header>

<script>
  const menu = document.querySelector(".nav-disclosure");
  const backdrop = document.querySelector(".nav-backdrop");
  if (menu instanceof HTMLDetailsElement) {
    let lockedScrollY = 0;
    let lockedGutter = 0;
    let scrollLocked = false;
    const lockScroll = () => {
      if (scrollLocked) return;
      const root = document.documentElement;
      lockedGutter = Math.max(0, window.innerWidth - root.clientWidth);
      const bodyWidth = window.innerWidth - lockedGutter;
      lockedScrollY = window.scrollY;
      scrollLocked = true;
      root.style.setProperty("--scrollbar-comp", `${lockedGutter}px`);
      const body = document.body;
      body.style.position = "fixed";
      body.style.top = `-${lockedScrollY}px`;
      body.style.left = "0";
      body.style.width = `${bodyWidth}px`;
    };
    const unlockScroll = () => {
      if (!scrollLocked) return;
      const y = lockedScrollY;
      scrollLocked = false;
      lockedGutter = 0;
      const root = document.documentElement;
      root.style.removeProperty("--scrollbar-comp");
      const body = document.body;
      body.style.position = "";
      body.style.top = "";
      body.style.left = "";
      body.style.width = "";
      root.getBoundingClientRect();
      window.scrollTo(0, y);
    };
    const setOpen = (open: boolean) => {
      const compact = window.matchMedia("(max-width: 1040px)").matches;
      const lock = open && compact;
      if (lock) lockScroll();
      document.documentElement.classList.toggle("menu-open", lock);
      if (backdrop instanceof HTMLButtonElement) backdrop.hidden = !open;
      if (!lock) unlockScroll();
    };
    const closeMenu = () => {
      menu.open = false;
      setOpen(false);
    };
    const summary = () => menu.querySelector("summary");
    const header = menu.closest(".site-header");
    menu.addEventListener("toggle", () => setOpen(menu.open));
    menu.addEventListener("click", (event) => {
      const link = event.target instanceof Element ? event.target.closest("a") : null;
      if (link) closeMenu();
    });
    document.addEventListener(
      "click",
      (event) => {
        if (!menu.open) return;
        if (!(event.target instanceof Node) || menu.contains(event.target)) return;
        const clickedLink = event.target instanceof Element ? event.target.closest("a") : null;
        closeMenu();
        if (!clickedLink) summary()?.focus({ preventScroll: true });
      },
      true,
    );
    document.addEventListener("focusin", (event) => {
      if (!menu.open || !(event.target instanceof Node)) return;
      if (header?.contains(event.target)) return;
      closeMenu();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menu.open) return;
      closeMenu();
      summary()?.focus({ preventScroll: true });
    });
    const compactNav = window.matchMedia("(max-width: 1040px)");
    compactNav.addEventListener("change", () => {
      if (!compactNav.matches) closeMenu();
    });
    window.addEventListener("resize", () => {
      if (!scrollLocked) return;
      document.body.style.width = `${window.innerWidth - lockedGutter}px`;
    });
  }
</script>
