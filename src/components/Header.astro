---
import Seal from "./Seal.astro";
import { hero, site } from "../data/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const links: { href: string; label: string; external?: boolean }[] = [
  { href: "/#how-it-works", label: "How it works" },
  { href: "/pricing", label: "Pricing" },
  { href: "/blog", label: "Blog" },
  { href: "/one-pager", label: "One-pager" },
  { href: "/sample-evidence-report", label: "Sample report" },
  { href: site.docsUrl, label: "Docs", external: true },
  { href: site.repo, label: "GitHub", external: true },
];

function isCurrent(href: string) {
  if (href.startsWith("/#")) return undefined;
  if (href === "/blog") {
    return pathname === "/blog" || pathname.startsWith("/blog/") ? "page" : undefined;
  }
  return pathname === href ? "page" : undefined;
}
---

<header class="site-header">
  <div class="wrap header-bar">
    <a class="brand" href="/" aria-current={pathname === "/" ? "page" : undefined}>
      <Seal />
      <span class="brand-text">
        <span class="brand-short" aria-hidden="true">SDF</span>
        <span class="brand-name">Software Decision Fabric</span>
        <span class="brand-tag">{site.headerTagline}</span>
      </span>
    </a>
    <nav class="primary-nav primary-nav-bar" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href)} rel={link.external ? "noopener noreferrer" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <details class="nav-disclosure">
      <summary class="nav-summary">Menu</summary>
      <nav class="primary-nav" aria-label="Primary">
        <a class="menu-cta" href="/#today">{hero.primaryCta}</a>
        {
          links.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href)} rel={link.external ? "noopener noreferrer" : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </details>
    <a class="button header-cta" href="/#today">{hero.primaryCta}</a>
  </div>
</header>

<script>
  const menu = document.querySelector(".nav-disclosure");
  if (menu instanceof HTMLDetailsElement) {
    menu.addEventListener("click", (event) => {
      const link = event.target instanceof Element ? event.target.closest("a") : null;
      if (link) menu.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menu.open) return;
      menu.open = false;
      menu.querySelector("summary")?.focus();
    });
  }
</script>
