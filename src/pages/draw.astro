---
import DrawLayout from "../layouts/DrawLayout.astro";
import DrawCanvas from "../components/DrawCanvas";

const title = "Scratch drawing tool: Software Decision Fabric";
const description =
  "Scratch drawing tool. Not part of SDF. Drawings stay in this browser and are not saved or sent anywhere. Some features load more files from this site the first time you use them.";
---

<DrawLayout title={title} description={description}>
  <DrawCanvas client:only="react" />
</DrawLayout>
