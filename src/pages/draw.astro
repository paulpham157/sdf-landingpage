---
import DrawLayout from "../layouts/DrawLayout.astro";
import DrawCanvas from "../components/DrawCanvas";

const title = "Scratch drawing tool (not part of SDF)";
const description =
  "Scratch drawing tool. Not part of SDF. Drawings are saved only in this browser and are not sent anywhere.";
---

<DrawLayout title={title} description={description}>
  <DrawCanvas client:only="react" />
</DrawLayout>
