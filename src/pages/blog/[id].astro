---
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPostDate, isoDate, publishedPosts } from "../../lib/blog";
import { absolute, graph } from "../../lib/seo";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = `/blog/${post.id}`;
const title = `${post.data.title} — Software Decision Fabric`;
const heroSrc = post.data.hero?.src;

const breadcrumbs = [
  { name: "Overview", href: "/" },
  { name: "Blog", href: "/blog" },
  { name: post.data.title, href: path },
];
const jsonLd = graph({
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.summary,
  datePublished: isoDate(post.data.date),
  inLanguage: "en",
  url: absolute(path),
  mainEntityOfPage: absolute(path),
  author: {
    "@type": "Organization",
    name: site.name,
    url: site.url,
  },
  publisher: {
    "@type": "Organization",
    name: site.name,
    url: site.url,
  },
});
---

<BaseLayout
  title={title}
  description={post.data.summary}
  path={path}
  jsonLd={jsonLd}
  image={heroSrc}
  imageAlt={post.data.heroAlt ?? post.data.title}
  imageWidth={post.data.hero?.width}
  imageHeight={post.data.hero?.height}
  ogType="article"
  published={post.data.date}
  breadcrumbs={breadcrumbs}
>
  <article class="post wrap narrow">
    {
      post.data.sample && (
        <p class="sample-banner" role="note">
          <strong>Sample.</strong> This piece is a specimen of the blog. It is not a customer story and not a result.
        </p>
      )
    }
    <p class="post-meta">
      <time datetime={isoDate(post.data.date)}>{formatPostDate(post.data.date)}</time>
      <span>{site.name}</span>
      {post.data.sample && <span class="post-sample">Sample</span>}
    </p>
    <h1 class="post-title">{post.data.title}</h1>
    <p class="lede tight">{post.data.summary}</p>
    {
      post.data.hero && (
        <Image
          src={post.data.hero}
          alt={post.data.heroAlt ?? post.data.title}
          class="post-hero"
        />
      )
    }
    {
      post.data.tags.length > 0 && (
        <ul class="tag-list">
          {post.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
    <div class="prose">
      <Content />
    </div>
    <p class="post-end">
      <a href="/blog">All notes</a>
      <a href="/design-partners">Become a design partner</a>
    </p>
  </article>
</BaseLayout>
