---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  closing,
  hero,
  pillarDocs,
  pillars,
  problem,
  shipsToday,
  site,
  statusLabel,
  stepDocs,
  steps,
  wedgeMetric,
} from "../data/site";
import { graph, webPage } from "../lib/seo";

const title = "SDF: Know which agent work actually shipped";
const description = `${site.tagline} It links agent sessions to commits and shows ${wedgeMetric} from merged pull requests. The independent referee loop is planned.`;

const jsonLd = graph(
  {
    "@type": "Organization",
    name: site.name,
    alternateName: site.shortName,
    url: site.url,
    description: site.tagline,
  },
  {
    "@type": "WebSite",
    name: site.name,
    url: `${site.url}/`,
    description,
  },
  webPage({ title, description, path: "/" }),
);
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">Open source · v0.1.0</p>
        <h1>{hero.title}</h1>
        <p class="lede">{hero.subhead}</p>
        <p class="buyer">{hero.buyer}</p>
        <div class="cta-row">
          <a class="button" href="/#today">{hero.primaryCta}</a>
          <a class="button button-secondary" href={site.repo} rel="noopener noreferrer">{hero.secondaryCta}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="why-title">
    <div class="wrap">
      <p class="kicker">§ 01. Why SDF</p>
      <h2 id="why-title">{problem.heading}</h2>
      <p class="statement">{problem.body}</p>
      <div class="pillars">
        {
          pillars.map((pillar, index) => (
            <article>
              <p class="step-index">0{index + 1}</p>
              <h3>{pillar.title}</h3>
              <p>{pillar.body}</p>
            </article>
          ))
        }
      </div>
      <p class="docs-line">
        {pillarDocs.before}<a href={site.outcomeDocsUrl} rel="noopener noreferrer">{pillarDocs.linkLabel}</a>{pillarDocs.after}
      </p>
    </div>
  </section>

  <section class="section" id="how-it-works" aria-labelledby="how-title">
    <div class="wrap">
      <p class="kicker">§ 02. How it works</p>
      <h2 id="how-title">How it works</h2>
      <p class="lede tight">Your agents stay in place. SDF records what they did.</p>
      <ol class="steps">
        {
          steps.map((step) => (
            <li>
              <span class="step-index">{step.id}</span>
              <h3>
                {step.title} <span class={`status-badge status-${step.status}`}>{statusLabel[step.status]}</span>
              </h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="docs-line">
        {stepDocs.before}<a href={site.commitLinkDocsUrl} rel="noopener noreferrer">{stepDocs.linkLabel}</a>{stepDocs.after}
      </p>
    </div>
  </section>

  <section class="section band" id="today" aria-labelledby="today-title">
    <div class="wrap">
      <p class="kicker">§ 03. Shipping today</p>
      <h2 id="today-title">{shipsToday.heading}</h2>
      <p class="lede tight">{shipsToday.body}</p>
      <pre class="install"><code><!--email_off-->{[shipsToday.install, shipsToday.installPin, ...shipsToday.run].join("\n")}<!--/email_off--></code></pre>
      <p class="step-today"><code>{shipsToday.note.command}</code>{shipsToday.note.after}</p>
      <p class="lede tight">{problem.coverage}</p>
      <p>
        <a class="repo-link" href={shipsToday.releaseUrl} rel="noopener noreferrer">Prebuilt archives for Linux, macOS, and Windows</a>
        {" · "}
        <a class="repo-link" href={site.repo} rel="noopener noreferrer">Setup for each agent on GitHub</a>
      </p>
    </div>
  </section>

  <section class="close" aria-labelledby="close-title">
    <div class="wrap close-grid">
      <div>
        <p class="kicker kicker-light">§ 04. Design partners</p>
        <h2 id="close-title">{closing.heading}</h2>
        <p class="lede light">{closing.body}</p>
        <div class="cta-row">
          <a class="button button-light" href="/design-partners">Apply to be a design partner</a>
          <a class="text-link" href="/one-pager">One-page version for a meeting</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
