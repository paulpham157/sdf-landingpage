---
import BaseLayout from "../layouts/BaseLayout.astro";
import DecisionChain from "../components/DecisionChain.astro";
import {
  closing,
  graphNodes,
  hero,
  moat,
  pillars,
  pricingIntro,
  problem,
  site,
  steps,
} from "../data/site";

const title = "SDF — Know which agent work actually shipped";
const description =
  "SDF is the independent referee for coding agents. It verifies every attempt against your acceptance criteria and shows the cost of each accepted outcome.";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: site.name,
      alternateName: site.shortName,
      url: site.url,
      description: site.tagline,
    },
    {
      "@type": "WebSite",
      name: site.name,
      url: `${site.url}/`,
      description,
    },
  ],
};
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">Independent referee</p>
        <h1>{hero.title}</h1>
        <p class="lede">{hero.subhead}</p>
        <p class="buyer">{hero.buyer}</p>
        <div class="cta-row">
          <a class="button" href="/design-partners">{hero.primaryCta}</a>
          <a class="button button-secondary" href="/sample-evidence-report">{hero.secondaryCta}</a>
        </div>
      </div>
      <aside class="stub" aria-label="Illustrative evidence stub, not a customer result">
        <p class="stub-flag"><span>Illustrative</span> Not a result</p>
        <dl>
          <div>
            <dt>Objective</dt>
            <dd>Ship retry with backoff for webhook delivery, linked to fewer dropped events.</dd>
          </div>
          <div>
            <dt>Acceptance</dt>
            <dd>Tests cover the failure paths. No new secret. One revision.</dd>
          </div>
          <div>
            <dt>Agent</dt>
            <dd>Whichever agent you already run. SDF does not supply one.</dd>
          </div>
          <div>
            <dt>Verdict</dt>
            <dd><strong class="verdict">PASS</strong> tied to revision <code>sample-c0ffee1</code></dd>
          </div>
          <div>
            <dt>Cost</dt>
            <dd>Recorded on the attempt. No amount is shown in this picture.</dd>
          </div>
        </dl>
        <p class="stub-foot">Format specimen for the story above. Not a customer report. SDF runs live only on a toy fixture.</p>
      </aside>
    </div>
  </section>

  <section class="section" id="problem" aria-labelledby="problem-title">
    <div class="wrap">
      <p class="kicker">§ 01 — The problem</p>
      <h2 id="problem-title">{problem.heading}</h2>
      <p class="statement">{problem.body}</p>
      <ul class="agent-row">
        {
          problem.agents.map((name) => (
            <li>
              <span class="agent-name">{name}</span>
              <span class="agent-mark">Grades its own work</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="how-it-works" aria-labelledby="how-title">
    <div class="wrap">
      <p class="kicker">§ 02 — How it works</p>
      <h2 id="how-title">How it works</h2>
      <p class="lede tight">Your agents stay in place. SDF checks the work and keeps the record.</p>
      <ol class="steps">
        {
          steps.map((step) => (
            <li>
              <span class="step-index">{step.id}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
      <DecisionChain
        nodes={graphNodes}
        caption="Append-only. The verdict is tied to the exact code revision, and the cost sits on the same record."
      />
      <p class="moat">{moat}</p>
    </div>
  </section>

  <section class="section" id="commitments" aria-labelledby="pillar-title">
    <div class="wrap">
      <p class="kicker">§ 03 — Three commitments</p>
      <h2 id="pillar-title">Vendor-neutral, verifiable, and measured on the outcome.</h2>
      <div class="pillars">
        {
          pillars.map((pillar, index) => (
            <article>
              <p class="step-index">0{index + 1}</p>
              <h3>{pillar.title}</h3>
              <p>{pillar.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="price-pointer-title">
    <div class="wrap price-pointer">
      <div>
        <p class="kicker">§ 04 — Pricing shape</p>
        <h2 id="price-pointer-title">{pricingIntro.lede}</h2>
        <p class="lede tight">{pricingIntro.unpublished}</p>
      </div>
      <a class="button button-secondary" href="/pricing">Read the comparison</a>
    </div>
  </section>

  <section class="close" aria-labelledby="close-title">
    <div class="wrap close-grid">
      <div>
        <p class="kicker kicker-light">§ 05 — Design partners</p>
        <h2 id="close-title">{closing.heading}</h2>
        <p class="lede light">{closing.body}</p>
        <div class="cta-row">
          <a class="button button-light" href="/design-partners">Apply to be a design partner</a>
          <a class="text-link" href="/one-pager">One-page version for a meeting</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
