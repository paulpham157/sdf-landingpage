---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  hero,
  homeCost,
  homeInstall,
  homePartners,
  homePartnersCta,
  homeVerify,
  shipsToday,
  wedgeMetric,
  site,
} from "../data/site";
import { graph, webPage } from "../lib/seo";

const title = "SDF: Know which agent work actually shipped";
const description = `${site.tagline} It links agent sessions to commits and shows ${wedgeMetric} from merged pull requests. The independent referee loop is planned.`;

const jsonLd = graph(
  {
    "@type": "Organization",
    name: site.name,
    alternateName: site.shortName,
    url: site.url,
    description: site.tagline,
  },
  {
    "@type": "WebSite",
    name: site.name,
    url: `${site.url}/`,
    description,
  },
  webPage({ title, description, path: "/" }),
);

const verifyPre = [
  `<span class="prompt">$ </span>${homeVerify.failCommand}`,
  `verdict <strong class="verdict verdict-fail">FAIL</strong> ${homeVerify.failHash}`,
  `  <span class="reason">${homeVerify.failReason}</span>`,
  "",
  `<span class="prompt">$ </span>${homeVerify.passCommand}`,
  `verdict <strong class="verdict">PASS</strong> ${homeVerify.passHash}`,
].join("\n");
---

<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker">Open source · v0.1.0</p>
        <h1>{hero.title}</h1>
        <p class="lede">{hero.subhead}</p>
        <div class="cta-row">
          <a class="button" href="/#today">{hero.primaryCta}</a>
          <a class="button button-secondary" href={site.repo} rel="noopener noreferrer">{hero.secondaryCta}</a>
        </div>
      </div>
      <section class="hero-proof" id="how-it-works" aria-labelledby="verify-title">
        <p class="kicker">§ 01. Proof: a checked commit</p>
        <h2 id="verify-title">{homeVerify.title}</h2>
        <figure class="proof">
          <figcaption class="proof-caption">
            <span class="proof-label">{homeVerify.label}</span>{` ${homeVerify.caption}`}
          </figcaption>
          <pre class="install terminal"><code set:html={`<!--email_off-->${verifyPre}<!--/email_off-->`} /></pre>
          <p class="step-today">{homeVerify.footnote}</p>
          <a class="repo-link" href={homeVerify.linkUrl} rel="noopener noreferrer">{homeVerify.linkLabel}</a>
        </figure>
      </section>
    </div>
  </section>

  <section class="section" aria-labelledby="cost-title">
    <div class="wrap">
      <p class="kicker">§ 02. Proof: cost that won't guess</p>
      <h2 id="cost-title">{homeCost.title}</h2>
      <figure class="proof">
        <figcaption class="proof-caption">
          <span class="proof-label">{homeCost.label}</span>{` ${homeCost.caption}`}
        </figcaption>
        <table class="checks proof-table" aria-labelledby="cost-title">
          <caption class="sr-only">Sample session costs</caption>
          <thead>
            <tr>
              {homeCost.columns.map((column) => <th scope="col">{column}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              homeCost.rows.map((row) => (
                <tr>
                  <th scope="row">{row[0]}</th>
                  <td data-label="Agent">{row[1]}</td>
                  <td data-label="Computed cost">{row[2]}</td>
                  <td data-label="Outcome">{row[3]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <pre class="install terminal cpao"><code><!--email_off-->{homeCost.cpao}<!--/email_off--></code></pre>
        <p class="step-today">{homeCost.footnote}</p>
        <a class="repo-link" href={homeCost.linkUrl} rel="noopener noreferrer">{homeCost.linkLabel}</a>
      </figure>
    </div>
  </section>

  <section class="section band" id="today" aria-labelledby="today-title">
    <div class="wrap">
      <p class="kicker">§ 03. Get started</p>
      <h2 id="today-title">{homeInstall.heading}</h2>
      <pre class="install"><code><!--email_off-->{homeInstall.lines.join("\n")}<!--/email_off--></code></pre>
      <p class="docs-line">
        {homeInstall.beforeArchive}<a href={shipsToday.releaseUrl} rel="noopener noreferrer">{homeInstall.archiveLabel}</a>{homeInstall.beforeDocs}<a href={homeInstall.docsUrl} rel="noopener noreferrer">{homeInstall.docsLabel}</a>{homeInstall.afterDocs}
      </p>
    </div>
  </section>

  <section class="close" aria-labelledby="close-title">
    <div class="wrap close-grid">
      <div>
        <p class="kicker kicker-light">§ 04. Design partners</p>
        <h2 id="close-title">Become a design partner</h2>
        <p class="lede light">{homePartners}</p>
        <div class="cta-row">
          <a class="button button-light" href="/design-partners">{homePartnersCta}</a>
          <a class="text-link" href="/one-pager">One-page version for a meeting</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
