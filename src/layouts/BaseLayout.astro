---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { jsonLdHtml, pageJsonLd, type Crumb } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: object;
  breadcrumbs?: Crumb[];
  /** Site-relative or absolute image. Defaults to the site social card. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: string;
  published?: Date;
  robots?: string;
}

const {
  title,
  description,
  path,
  jsonLd,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  ogType = "website",
  published,
  robots = "index, follow",
  breadcrumbs = [],
} = Astro.props;
const structuredData = pageJsonLd(jsonLd, breadcrumbs);
const canonical = new URL(path, Astro.site).href;
const ogImage = image
  ? image.startsWith("http://") || image.startsWith("https://")
    ? image
    : new URL(image, Astro.site).href
  : new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F6F1E8" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {
      imageWidth && imageHeight ? (
        <>
          <meta property="og:image:width" content={String(imageWidth)} />
          <meta property="og:image:height" content={String(imageHeight)} />
        </>
      ) : (
        !image && (
          <>
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
          </>
        )
      )
    }
    <meta property="og:image:alt" content={imageAlt ?? "Software Decision Fabric, a local OpenTelemetry collector and decision ledger for coding agents. Know which agent work actually shipped."} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt ?? "Software Decision Fabric, a local OpenTelemetry collector and decision ledger for coding agents. Know which agent work actually shipped."} />
    {structuredData && <script type="application/ld+json" set:html={jsonLdHtml(structuredData)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <p class="status-bar">
      <span class="wrap status-inner">{site.statusBar}</span>
    </p>
    {
      breadcrumbs.length > 0 && (
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol class="wrap">
            {breadcrumbs.map((crumb, index) => (
              <li>
                {index < breadcrumbs.length - 1 ? (
                  <a href={crumb.href}>{crumb.name}</a>
                ) : (
                  <span aria-current="page">{crumb.name}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      function scrollPaddingTop() {
        const parsed = Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop);
        return Number.isFinite(parsed) ? parsed : 0;
      }

      function scrollToTarget(target: HTMLElement) {
        const top = Math.max(0, target.getBoundingClientRect().top + window.scrollY - scrollPaddingTop());
        if (reduceMotion.matches) {
          window.scrollTo({ top, behavior: "auto" });
          return;
        }
        const start = window.scrollY;
        const delta = top - start;
        const duration = 260;
        const started = performance.now();
        const frame = (now: number) => {
          const progress = Math.min(1, (now - started) / duration);
          const eased = 1 - (1 - progress) ** 2;
          window.scrollTo(0, start + delta * eased);
          if (progress < 1) requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      }

      document.addEventListener("click", (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }
        const link = event.target instanceof Element ? event.target.closest("a[href]") : null;
        if (!(link instanceof HTMLAnchorElement) || (link.target && link.target !== "_self")) return;
        const url = new URL(link.href, location.href);
        if (url.origin !== location.origin || url.pathname !== location.pathname || url.hash.length < 2) return;
        const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
        if (!target) return;
        event.preventDefault();
        if (location.hash !== url.hash) history.pushState(null, "", `${url.pathname}${url.search}${url.hash}`);
        scrollToTarget(target);
      });
    </script>
  </body>
</html>
